						};
					};

					home_key {

						home_key_default {
							function = "normal";
							pins = "gpio11";
							input-enable;
							phandle = <0x3d4>;
							bias-pull-up;
						};
					};

					pmi_clk {

						pmi_clk_default {
							status = "ok";
							function = "func1";
							qcom,drive-strength = <0x02>;
							pins = "gpio3";
							output-low;
							phandle = <0x1fe>;
							output-enable;
						};
					};

					gpio@c300 {
						status = "okay";
						qcom,vin-sel = <0x01>;
						qcom,mode = <0x00>;
						qcom,master-en = <0x01>;
						qcom,src-sel = <0x00>;
					};

					gpio@ca00 {
						status = "okay";
						qcom,pull = <0x00>;
						qcom,vin-sel = <0x00>;
						qcom,mode = <0x00>;
						qcom,src-sel = <0x00>;
						qcom,out-strength = <0x01>;
					};

					gpio@c200 {
						status = "ok";
						qcom,invert = <0x00>;
						qcom,pull = <0x05>;
						qcom,vin-sel = <0x00>;
						qcom,mode = <0x01>;
						qcom,master-en = <0x01>;
						qcom,src-sel = <0x00>;
					};

					gpio@cb00 {
						status = "okay";
						qcom,pull = <0x05>;
						qcom,vin-sel = <0x00>;
						qcom,mode = <0x01>;
						qcom,src-sel = <0x00>;
						qcom,out-strength = <0x01>;
					};
				};

				qcom,pm660_rtc {
					compatible = "qcom,pm8941-rtc";
					interrupts = <0x00 0x61 0x01 0x00>;
					phandle = <0x286>;
				};

				vadc@3400 {
					reg = <0x3400 0x100>;
					#size-cells = <0x00>;
					qcom,pmic-revid = <0x65>;
					compatible = "qcom,adc-tm-rev2";
					io-channels = <0x6b 0x4c 0x6b 0x4d 0x6b 0x51>;
					interrupt-names = "thr-int-en";
					#address-cells = <0x01>;
					#thermal-sensor-cells = <0x01>;
					interrupts = <0x00 0x34 0x00 0x01>;
					phandle = <0x75>;

					quiet_therm {
						reg = <0x51>;
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
					};

					xo_therm {
						reg = <0x4c>;
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
					};

					msm_therm {
						reg = <0x4d>;
						qcom,hw-settle-time = <0xc8>;
						qcom,ratiometric;
					};
				};

				qcom,power-on@800 {
					reg = <0x800 0x100>;
					qcom,s3-src = "kpdpwr-and-resin";
					compatible = "qcom,qpnp-power-on";
					interrupt-names = "kpdpwr", "resin", "resin-bark", "kpdpwr-resin-bark";
					qcom,system-reset;
					qcom,kpdpwr-sw-debounce;
					interrupts = <0x00 0x08 0x00 0x00 0x00 0x08 0x01 0x00 0x00 0x08 0x04 0x00 0x00 0x08 0x05 0x00>;
					phandle = <0x285>;
					qcom,store-hard-reset-reason;
					qcom,pon-dbc-delay = <0x3d09>;

					qcom,pon_1 {
						qcom,pon-type = <0x00>;
						qcom,s2-timer = <0x7d0>;
						qcom,support-reset = <0x01>;
						qcom,s2-type = <0x07>;
						linux,code = <0x74>;
						qcom,pull-up = <0x01>;
						qcom,s1-timer = <0x2810>;
					};

					qcom,pon_2 {
						qcom,pon-type = <0x01>;
						linux,code = <0x72>;
						qcom,pull-up = <0x01>;
					};
				};

				rradc@4500 {
					reg = <0x4500 0x100>;
					#size-cells = <0x00>;
					qcom,pmic-revid = <0x65>;
