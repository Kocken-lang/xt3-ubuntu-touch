# Ingen artificiell strypning - alla klocks/effektdomäner tillgängliga
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_QCOM_CPUFREQ_NVMEM=y
CONFIG_QCOM_CPUFREQ_HW=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_RPMPD=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SDM660=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_DRM_FREEDRENO=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_AES_ARM64_CE=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_SHA2_ARM64_CE=y
# Gränssnitt som enterprise-stacken använder
CONFIG_SERIAL_MSM_HS=m
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_ACM=y
CONFIG_GPIO_SYSFS=y
CONFIG_I2C_CHARDEV=y
CONFIG_SPI_SPIDEV=y
CONFIG_HIDRAW=y
