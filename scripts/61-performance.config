# Ingen artificiell strypning - alla klocks/effektdomaner tillgangliga.
# Symbolnamnen ar verifierade mot Kconfig i qcom-sdm660-7.2.y.
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ARM_QCOM_CPUFREQ_NVMEM=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_RPMPD=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SDM660=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_AES_ARM64_CE_CCM=y
# GPU: DRM_MSM ar freedreno/adreno-drivrutinen i mainline (inget DRM_FREEDRENO-symbol finns)
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_MSM_DSI=y
# Granssnitt som enterprise-stacken anvander
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL_OPTION=m
CONFIG_I2C_CHARDEV=y
CONFIG_SPI_SPIDEV=y
CONFIG_HIDRAW=y
CONFIG_GPIO_CDEV=y
CONFIG_DRM_PANEL_JANAM_XT3=y
