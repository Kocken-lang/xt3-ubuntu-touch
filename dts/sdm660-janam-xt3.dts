// SPDX-License-Identifier: GPL-2.0-only
/*
 * Janam XT3 (Qualcomm SDA660) - mainline bring-up
 *
 * All values below come from one of:
 *   out/fota/dtbo/dtb/*.dts        stock 91.57 device tree overlays
 *   inventory-data/                live inventory from the device
 *   docs/02-enhetsmatris.md        Janam XT3 User Manual
 *
 * Nothing here is invented.  Where the stock DTB does not give a value the
 * line says TODO and the node stays disabled, so a wrong guess can never
 * brown out a rail or claim a bus that belongs to another device.
 *
 * Confirmed from the stock overlays:
 *   panel     JD9365DA 720p video (bekraftat: /sys/class/graphics/fb0/
 *             msm_fb_panel_info -> panel_name=jd9365da 720p video mode
 *             dsi panel), reset tlmm 53, TE tlmm 59, enable tlmm 8
 *   touch     Synaptics RMI4 @ i2c4 0x20, irq tlmm 67, reset tlmm 66
 *             (Goodix GT1x is the second source on the same pins, 0x14)
 *   expander  PCA9535 @ i2c1 0x22, irq tlmm 72, drives SAM control lines
 *   gauge     CW2015 @ i2c2 0x62, charge status tlmm 45
 *   NFC       PN54x @ i2c6 0x28, irq 28, ven 29, firm 30, clkreq pm660 gpio 4
 *   scanner   HSM imager @ i2c8 0x18, CSI2 port 2, 2 lanes, 11 GPIOs
 *   MSR       Wiznova MMD1000 on BLSP1 QUP3 SPI, irq 83, reset 63
 *   SAM       TDA8029 x2 behind PCA9535, card mux via sgm6503b
 *   keys      battery-open tlmm 76, battery-cover tlmm 40
 *   SD card   card detect tlmm 70
 */

/dts-v1/;

#include "sdm660.dtsi"
#include "pm660.dtsi"
#include "pm660l.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/interrupt-controller/irq.h>

/* Generated by scripts/13-panel-from-dtb.py.  See that file for provenance. */
#include "panel-janam-xt3.dtsi"

/ {
        model = "Janam XT3";
        compatible = "janam,xt3", "qcom,sda660";
        chassis-type = "handset";

        /*
         * Qualcomm-ABL validerar dessa tre innan den hoppar till kärnan.
         * Värdena är lästa ur enhetens egen boot-DTB (91.57, from-boot.dtb),
         * inte gissade. Stock-DTB:n har msm-id och pmic-id men INGEN
         * board-id - den hor till dtbo-varianten, och en felaktig board-id
         * kan fa ABL att matcha fel och vagra.
         */
        qcom,msm-id = <0x144 0x00>;
        qcom,pmic-id = <0x1001b 0x101011a 0x00 0x00
                        0x1001b 0x201011a 0x00 0x00
                        0x1001b 0x102001a 0x00 0x00>;

        /*
         * ABL fyller i reg på /memory innan den hoppar till kärnan. Noden
         * måste finnas - stock-DTB:n har den utan reg. Utan nod får kärnan
         * ingen RAM alls.
         */
        memory {
                device_type = "memory";
        };

        /*
         * ABL lamnar kvar sin splash-framebuffer pa 0x9d400000
         * (cont_splash_mem, 0x2300000 byte i stock-DTB:n). Genom att
         * beskriva den som simple-framebuffer tar simpledrm over den och vi
         * far textkonsol pa skarmen - enda loggkanalen utan UART.
         * 720x1280 ARGB8888 -> stride 2880, 0x384000 byte.
         */
        reserved-memory {
                #address-cells = <2>;
                #size-cells = <2>;
                ranges;

                splash_region: splash@9d400000 {
                        reg = <0x0 0x9d400000 0x0 0x2300000>;
                        label = "cont_splash_mem";
                };
        };

        framebuffer@9d400000 {
                compatible = "simple-framebuffer";
                reg = <0x0 0x9d400000 0x0 0x384000>;
                width = <720>;
                height = <1280>;
                stride = <2880>;
                format = "a8r8g8b8";
        };

        aliases {
                serial0 = &blsp1_uart2;
        };

        chosen {
                stdout-path = "serial0:115200n8";
        };

        battery: battery {
                compatible = "simple-battery";
                /*
                 * Measured on the device (inventory 33-battery.txt):
                 * 4340 mV at 100 %, charge counter 2.84 Ah.
                 */
                charge-full-design-microamp-hours = <3000000>;
                voltage-min-design-microvolt = <3400000>;
                voltage-max-design-microvolt = <4350000>;
        };

        /*
         * Placeholder rails for the touch controller.  The bootloader leaves
         * them on; these nodes only let the driver enable/disable without
         * touching the PMIC.  Replace with the real PM660 L3 / L11 regulator
         * nodes once from-boot.dtb gives the voltages.
         */
        xt3_vreg_touch_3v3: regulator-touch-3v3 {
                compatible = "regulator-fixed";
                regulator-name = "xt3_touch_3v3";
                regulator-min-microvolt = <3300000>;
                regulator-max-microvolt = <3300000>;
                regulator-always-on;
                regulator-boot-on;
        };

        xt3_vreg_touch_1v8: regulator-touch-1v8 {
                compatible = "regulator-fixed";
                regulator-name = "xt3_touch_1v8";
                regulator-min-microvolt = <1800000>;
                regulator-max-microvolt = <1800000>;
                regulator-always-on;
                regulator-boot-on;
        };

        /*
         * SoC-mandated PHY rails.  The voltages come from the SDM660 data
         * sheet, not from the board, so they are safe to describe before the
         * PMIC mapping is known.  They are always-on placeholders: the
         * bootloader already enabled them and these nodes never write to the
         * PMIC.  Replace with the real PM660 regulators once from-boot.dtb
         * tells which LDO feeds each rail.
         */
        xt3_vreg_vdd_0p925: regulator-vdd-0p925 {
                compatible = "regulator-fixed";
                regulator-name = "xt3_vdd_0p925";
                regulator-min-microvolt = <925000>;
                regulator-max-microvolt = <925000>;
                regulator-always-on;
                regulator-boot-on;
        };

        xt3_vreg_vdda_1p225: regulator-vdda-1p225 {
                compatible = "regulator-fixed";
                regulator-name = "xt3_vdda_1p225";
                regulator-min-microvolt = <1225000>;
                regulator-max-microvolt = <1225000>;
                regulator-always-on;
                regulator-boot-on;
        };

        xt3_vreg_vdda_1p8: regulator-vdda-1p8 {
                compatible = "regulator-fixed";
                regulator-name = "xt3_vdda_1p8";
                regulator-min-microvolt = <1800000>;
                regulator-max-microvolt = <1800000>;
                regulator-always-on;
                regulator-boot-on;
        };

        xt3_vreg_vdda_3p125: regulator-vdda-3p125 {
                compatible = "regulator-fixed";
                regulator-name = "xt3_vdda_3p125";
                regulator-min-microvolt = <3125000>;
                regulator-max-microvolt = <3125000>;
                regulator-always-on;
                regulator-boot-on;
        };

        gpio-keys {
                compatible = "gpio-keys";
                label = "gpio-keys";

                /*
                 * Key map from the stock base DTB (keypad node in
                 * from-boot.dtb).  Codes are the vendor's own linux,code
                 * values.  528, 546, 766 and 1023 have no mainline name, so
                 * they stay numeric and are mapped by xt3-gpiod.
                 * Polarity is assumed active-low (pull-up, press to ground),
                 * which is what every QRD keypad uses; verify with evtest.
                 */
                program-key {
                        label = "program_key";
                        gpios = <&tlmm 42 GPIO_ACTIVE_LOW>;
                        linux,code = <528>;
                        debounce-interval = <15>;
                };

                scan-left {
                        label = "scan_left";
                        gpios = <&tlmm 65 GPIO_ACTIVE_LOW>;
                        linux,code = <546>;
                        debounce-interval = <15>;
                };

                scan-right {
                        label = "scan_right";
                        gpios = <&tlmm 113 GPIO_ACTIVE_LOW>;
                        linux,code = <766>;
                        debounce-interval = <15>;
                };

                gun-trigger {
                        label = "gun_trigger_key";
                        gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;
                        linux,code = <223>;
                        debounce-interval = <15>;
                };

                volume-up {
                        label = "volume_up";
                        gpios = <&tlmm 7 GPIO_ACTIVE_LOW>;
                        linux,code = <KEY_VOLUMEUP>;
                        debounce-interval = <15>;
                };

                key-home {
                        label = "home_key";
                        gpios = <&tlmm 60 GPIO_ACTIVE_LOW>;
                        linux,code = <KEY_HOMEPAGE>;
                        debounce-interval = <15>;
                };

                key-back {
                        label = "back_key";
                        gpios = <&tlmm 48 GPIO_ACTIVE_LOW>;
                        linux,code = <KEY_BACK>;
                        debounce-interval = <15>;
                };

                key-menu {
                        label = "menu_key";
                        gpios = <&tlmm 64 GPIO_ACTIVE_LOW>;
                        linux,code = <KEY_MENU>;
                        debounce-interval = <15>;
                };

                wake-on-motion {
                        label = "wake_on_motion";
                        gpios = <&tlmm 68 GPIO_ACTIVE_LOW>;
                        linux,code = <1023>;
                        debounce-interval = <15>;
                        wakeup-source;
                };

                /* Switches added by the stock overlay (dtbo). */
                battery-open {
                        label = "battery_open";
                        gpios = <&tlmm 76 GPIO_ACTIVE_LOW>;
                        linux,input-type = <EV_SW>;
                        linux,code = <0x1f>;      /* vendor specific switch */
                        debounce-interval = <15>;
                        wakeup-source;
                };

                battery-cover {
                        label = "battery_cover";
                        gpios = <&tlmm 40 GPIO_ACTIVE_LOW>;
                        linux,input-type = <EV_SW>;
                        linux,code = <SW_MACHINE_COVER>;
                        debounce-interval = <15>;
                };
        };
};

/* --- Console / debug ------------------------------------------------- */
&blsp1_uart2 {
        status = "okay";
};

/* --- Storage -------------------------------------------------------- */
&sdhc_1 {
        status = "okay";
        non-removable;
        /* TODO: vmmc-supply / vqmmc-supply from from-boot.dtb */
};

&sdhc_2 {
        status = "okay";
        cd-gpios = <&tlmm 70 GPIO_ACTIVE_HIGH>;
        /* TODO: vmmc-supply / vqmmc-supply from from-boot.dtb */
};

/* --- USB (adb/fastboot + external RF88/MSR sled) --------------------- */
&usb3 {
        status = "okay";
};

&usb3_dwc3 {
        dr_mode = "peripheral";
};

&qusb2phy0 {
        vdd-supply = <&xt3_vreg_vdd_0p925>;
        vdda-pll-supply = <&xt3_vreg_vdda_1p8>;
        vdda-phy-dpdm-supply = <&xt3_vreg_vdda_3p125>;
        status = "okay";
};

/* --- Display / GPU -------------------------------------------------- */
&mdss {
        status = "okay";
};

&mdss_dsi0 {
        vdd-supply = <&xt3_vreg_vdd_0p925>;
        vdda-supply = <&xt3_vreg_vdda_1p225>;
        status = "okay";
};

&mdss_dsi0_phy {
        vcca-supply = <&xt3_vreg_vdd_0p925>;
        status = "okay";
};

&adreno_gpu {
        status = "okay";
};

&mmss_smmu {
        status = "okay";
};

/* --- Touch (Synaptics RMI4, second source Goodix GT1x) -------------- */
&blsp_i2c4 {
        status = "okay";

        touchscreen@20 {
                compatible = "syna,rmi4-i2c";
                reg = <0x20>;

                interrupt-parent = <&tlmm>;
                interrupts = <67 IRQ_TYPE_LEVEL_LOW>;

                reset-gpios = <&tlmm 66 GPIO_ACTIVE_LOW>;
                vdd-supply = <&xt3_vreg_touch_3v3>;
                vio-supply = <&xt3_vreg_touch_1v8>;
                syna,startup-delay-ms = <100>;

                #address-cells = <1>;
                #size-cells = <0>;

                rmi4-f01@1 {
                        reg = <0x1>;
                        syna,nosleep-mode = <1>;
                };

                rmi4-f12@12 {
                        reg = <0x12>;
                        syna,sensor-type = <1>;
                };
        };
};

/* --- GPIO expander that owns the SAM control lines ------------------ */
&blsp_i2c1 {
        status = "okay";

        expander: gpio@22 {
                compatible = "nxp,pca9535";
                reg = <0x22>;

                gpio-controller;
                #gpio-cells = <2>;
                interrupt-controller;
                #interrupt-cells = <2>;

                interrupt-parent = <&tlmm>;
                interrupts = <72 IRQ_TYPE_LEVEL_LOW>;
        };
};

/* --- Fuel gauge ----------------------------------------------------- */
&blsp_i2c2 {
        status = "okay";

        fuel-gauge@62 {
                compatible = "cellwise,cw2015";
                reg = <0x62>;
                status = "disabled";
                /* TODO: cellwise,battery-profile + chg-sts gpio 45 */
        };
};

/* --- NFC (PN54x) ---------------------------------------------------- */
&blsp_i2c6 {
        status = "okay";

        nfc@28 {
                compatible = "nxp,pn544-i2c";
                reg = <0x28>;
                status = "disabled";

                interrupt-parent = <&tlmm>;
                interrupts = <28 IRQ_TYPE_LEVEL_LOW>;

                enable-gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
                firmware-gpios = <&tlmm 30 GPIO_ACTIVE_HIGH>;

                /* TODO: ref_clk (vendor uses BBCLK3) + rails */
        };
};

/* --- Power / charger ------------------------------------------------ */
&pm660_charger {
        monitored-battery = <&battery>;
        status = "okay";
};

&pm660_fg {
        monitored-battery = <&battery>;
        power-supplies = <&pm660_charger>;
        status = "okay";
};

&pm660_haptics {
        status = "okay";
};

&pm660_rradc {
        status = "okay";
};

&pm660l_wled {
        status = "okay";
};

&pon_pwrkey {
        status = "okay";
};

&pon_resin {
        linux,code = <KEY_VOLUMEDOWN>;
        status = "okay";
};

/* --- Radios: enable after the rails are read from from-boot.dtb ------ */
&wifi {
        status = "disabled";
        /* TODO: vdd-0.8-cx-mx, vdd-1.8-xo, vdd-1.3-rfa, vdd-3.3-ch0 */
};

&remoteproc_mss {
        status = "okay";
        firmware-name = "qcom/mba.mbn", "qcom/modem.mdt";
};

&adsp_pil {
        status = "okay";
};

&venus {
        status = "okay";
};

/*
 * --- Not yet representable in mainline ------------------------------
 *
 * scanner: hsm,imager on i2c8 @0x18, CSI2 port 2, 2 lanes.
 *   GPIOs: power-en 1, aimer 2, illuminator 3, engine-reset 4,
 *          3v3-laser 5, 3v3-imager 6, flash-out 7, level-shift-3v3-en 8,
 *          scan-io-level-shift-en 9, i2c-level-shift-en 10, scan-buf-dir 11
 *          (all on &pm660l_gpios, from the stock overlay).
 *   Needs a V4L2 subdev driver plus camss capture.  The decode runs in
 *   userspace on the CSI frames; this is not a serial scanner.
 *
 * MSR: wiznova,mmd1000 on BLSP1 QUP3 SPI (0xc177000), max 960 kHz,
 *   vdd-3p3-en pm660 gpio 6, irq tlmm 83, reset tlmm 63.
 *   Mainline has no SPI controller node for QUP3 yet; add one and bind
 *   spidev until the MMD1000 protocol driver exists.
 *
 * SAM: two TDA8029 smart card interfaces behind the PCA9535
 *   (enable/shutdown/reset on expander lines 0/5/4, irq tlmm 43,
 *   card mux sgm6503b select on expander line 3).  TDA8029 is a UART
 *   device; the UART instance is in the base DTB.
 *
 * RFID: RF88 is an external USB sled (ttyACM / ttyXRUSB), no on-board part.
 */
